{
  // Cloudflare Workers Static Assets config for the Tsuru Sushi static SPA.
  // Tells `wrangler deploy` / `wrangler versions upload` where the built site
  // lives so it has something to upload.
  //
  // IMPORTANT: "name" must match your Cloudflare Worker/project name exactly.
  // If your project is named something other than "tsuru-sushi", change this
  // one line to match it (or rename the project in the dashboard to match).
  "name": "tsuru-sushi",
  "compatibility_date": "2026-06-17",
  "assets": {
    "directory": "./dist",
    // Serve index.html for any path that isn't a real file, so client-side
    // (React Router) routing works. This is the Workers way to do SPA fallback.
    "not_found_handling": "single-page-application"
  }
}
